<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/editarPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="botonEditarPerfil"
        android:text="Editar perfil" />

    <Button
        android:id="@+id/btnVincularQR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vincular por qr" />

    <Button
        android:id="@+id/notificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="botonIrNotificaciones"
        android:text="Notificaciones" />

    <!-- Nuevo botón para desconectar Bluetooth -->
    <Button
        android:id="@+id/btnForzarDesconexion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Forzar desconexión BLE"
        android:onClick="botonForzarDesconexion" />

    <Button
        android:id="@+id/btnDistanciaRecorrida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="btnDistanciaRecorrida"
        android:text="Distancia Recorrida" />

</LinearLayout>
